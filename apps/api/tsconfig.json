{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true
  },
  "include": [
    "src/server.ts",
    "src/db.ts",
    "src/auth/**/*.ts",
    "src/users/**/*.ts",
    "src/plans/**/*.ts",
    "src/voucher/**/*.ts",
    "src/payments/**/*.ts",
    "src/affiliate/**/*.ts"
  ]
}
